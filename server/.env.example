# ---- Server ----
PORT=4000
NODE_ENV=development
# Long random string. REQUIRED in production (server refuses to boot with the dev default).
JWT_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# Leave empty for zero-setup local dev (embedded Postgres via PGlite, stored in ./data/pgdata).
# Set to a Postgres URL (Neon / Supabase / Render) for deployment.
DATABASE_URL=

# ---- Demo ----
# Shows quick-fill demo accounts on the login screen. Turn OFF for a real deployment.
DEMO_MODE=true
SEED_AUTHOR_PASSWORD=bookleaf123
SEED_ADMIN_PASSWORD=admin123
# Pin "today" for payout-date maths (YYYY-MM-DD). Empty = real date.
APP_TODAY=

# ---- LLM (all optional: with no keys the app still works using the rules fallback) ----
# Providers are tried in this order; each has retries + a circuit breaker.
LLM_PROVIDERS=gemini,groq

GROQ_API_KEY=
# Groq retired llama-3.1-8b-instant / llama-3.3-70b-versatile on 2026-08-16.
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_DRAFT=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_DRAFT=gemini-3.5-flash-lite
# 0 turns thinking off on 3.x models (cheaper, faster, saves reasoning tokens).
GEMINI_THINKING_BUDGET=0

LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=2
LLM_DAILY_CAP=500
LLM_ENABLED=true
